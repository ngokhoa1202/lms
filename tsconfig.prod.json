{
  "compilerOptions": {
    "target": "ES2024",
    "module": "CommonJS",
    "lib": [
      "ES2024"
    ],
    "strict": true,
    "baseUrl": "./",
    "outDir": "temp",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "paths": {
      "@src/*": [
        "src/*"
      ]
    },
    "useUnknownInCatchVariables": false,
    "sourceMap": false,
    "removeComments": true
  },
  "include": [
    "src/**/*.ts",
    "config.ts"
  ],
  "exclude": [
    "spec",
    "src/public/",
    "scripts",
    "eslint.config.ts"
  ]
}
